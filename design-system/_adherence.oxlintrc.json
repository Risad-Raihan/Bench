{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/calendar/**",
              "components/chrome/**",
              "components/data/**",
              "components/decisions/**",
              "components/docs/**",
              "components/forms/**",
              "components/kanban/**",
              "components/layout/**",
              "components/notes/**",
              "components/overlay/**",
              "components/pipeline/**",
              "components/venture/**",
              "components/work/**",
              "ui_kits/bench/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|dimmed|mark|onNavigate|onNewVenture|newLabel|onJump|jumpLabel|jumpKey|menuItems|onMenuSelect|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: items, active, dimmed, mark, onNavigate, onNewVenture, newLabel, onJump, jumpLabel, jumpKey, menuItems, onMenuSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:parent|current|color|onBack|switchLabel|onSwitch|key|ref|className|style|children)$/]",
        "message": "<BackStrip> doesn't accept that prop. Declared props: parent, current, color, onBack, switchLabel, onSwitch."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:decision|date|who|venture|ventureColor|source|rationale|expanded|onToggle|onOpenSource|key|ref|className|style|children)$/]",
        "message": "<DecisionRow> doesn't accept that prop. Declared props: decision, date, who, venture, ventureColor, source, rationale, expanded, onToggle, onOpenSource."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|flag|color|onClick|key|ref|className|style|children)$/]",
        "message": "<EventCard> doesn't accept that prop. Declared props: time, title, flag, color, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:k|v|color|mono|key|ref|className|style|children)$/]",
        "message": "<FactRow> doesn't accept that prop. Declared props: k, v, color, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|type|typeColor|size|who|date|versions|on|expanded|onClick|onExpand|key|ref|className|style|children)$/]",
        "message": "<FileRow> doesn't accept that prop. Declared props: name, type, typeColor, size, who, date, versions, on, expanded, onClick, onExpand."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|children|footer|width|onClose|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, eyebrow, children, footer, width, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:groups|active|onSelect|key|ref|className|style|children)$/]",
        "message": "<NoteSidebar> doesn't accept that prop. Declared props: groups, active, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|right|children|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, meta, right, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|right|children|pad|flush|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: label, right, children, pad, flush."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|options|note|key|ref|className|style|children)$/]",
        "message": "<SwatchPicker> doesn't accept that prop. Declared props: label, value, onChange, options, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|who|note|due|fromNote|done|color|onClick|key|ref|className|style|children)$/]",
        "message": "<TaskCard> doesn't accept that prop. Declared props: title, who, note, due, fromNote, done, color, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|venture|ventureColor|lane|laneColor|date|late|done|onToggle|onClick|key|ref|className|style|children)$/]",
        "message": "<TaskRow> doesn't accept that prop. Declared props: title, venture, ventureColor, lane, laneColor, date, late, done, onToggle, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|optional|multiline|autoFocus|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, placeholder, optional, multiline, autoFocus."
      },
      {
        "selector": "JSXOpeningElement[name.name='VentureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|caption|color|gates|gateTotal|who|founder|flag|onClick|rise|showGates|showMeta|key|ref|className|style|children)$/]",
        "message": "<VentureCard> doesn't accept that prop. Declared props: name, caption, color, gates, gateTotal, who, founder, flag, onClick, rise, showGates, showMeta."
      },
      {
        "selector": "JSXOpeningElement[name.name='VentureHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|sub|tags|stage|stageMeta|color|key|ref|className|style|children)$/]",
        "message": "<VentureHeader> doesn't accept that prop. Declared props: name, sub, tags, stage, stageMeta, color."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AppBar": { "replaces": [] },
      "BackStrip": { "replaces": [] },
      "DecisionRow": { "replaces": [] },
      "EventCard": { "replaces": [] },
      "FactRow": { "replaces": [] },
